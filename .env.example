# Copy to .env (never commit .env).
# Key the service sends to the LLM server (vLLM --api-key or a hosted provider).
GATEDRAG_LLM_API_KEY=
# Optional tracing: console | otlp
GATEDRAG_OTEL=

# --- docker/docker-compose.gpu.yml ---
# Pin an exact vLLM image tag at deploy time (check https://hub.docker.com/r/vllm/vllm-openai/tags).
VLLM_IMAGE_TAG=
MODEL_ID=Qwen/Qwen2.5-7B-Instruct
# Random secret shared by gatedrag and vLLM; generate with: openssl rand -hex 24
LLM_API_KEY=
HF_TOKEN=
GATEDRAG_WORKERS=2
